# Generative Interface Runtime — environment configuration
#
# Copy this file to `.env.local` and fill in your own values.
# Vite reads `.env.local` automatically at dev/build time.
# Any variable left blank → the app falls back to MockPlanner (offline, deterministic).
#
# Architecture note: in dev, a small Vite middleware (vite/apiProxy.ts)
# forwards POST /api/chat to the upstream LLM. The frontend never holds
# the API key. In production, deploy any backend that implements the
# same /api/chat contract (auth header added server-side) and set
# VITE_OPENAI_BASE_URL to its origin.

# ============================================================
# Frontend-visible (VITE_ prefix → embedded in the bundle)
# ============================================================

# Base URL the frontend calls. Defaults to /api (same-origin proxy in dev).
# In production, point this at your backend origin.
#   Dev:     /api
#   Prod:    https://your-backend.example.com
#VITE_OPENAI_BASE_URL=/api

# Model name. Public — no secret. Frontend builds the request body.
#VITE_OPENAI_MODEL=MiniMax-M3

# ============================================================
# Server-side ONLY (no VITE_ prefix → never reaches the bundle)
# Read by the Vite dev-server middleware.
# ============================================================

# OpenAI-compatible upstream base URL, no trailing slash.
# Default: https://api.minimax.io/v1
# Other working options:
#   OpenAI        https://api.openai.com/v1
#   Together      https://api.together.xyz/v1
#   Groq          https://api.groq.com/openai/v1
#   Ollama (local) http://localhost:11434/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Your MiniMax API key (issued from platform.minimax.io).
MINIMAX_API_KEY=

# Set to 1 to log every proxied request to the terminal.
#MINIMAX_DEBUG=0
